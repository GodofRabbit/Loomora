{
  "name": "Loomora",
  "version": "1.0.0",
  "description": "文生图工作台",
  "main": "main.js",
  "scripts": {
    "dev": "concurrently -k \"npm:dev:ui\" \"npm:dev:electron\"",
    "dev:ui": "vite --host 127.0.0.1 --port 5173",
    "dev:electron": "wait-on http://127.0.0.1:5173 && cross-env VITE_DEV_SERVER_URL=http://127.0.0.1:5173 electron .",
    "build:ui": "vite build",
    "start": "npm run build:ui && electron .",
    "dist": "electron-builder --win nsis"
  },
  "dependencies": {
    "vue": "^3.4.31"
  },
  "devDependencies": {
    "electron": "^31.0.0",
    "electron-builder": "^24.13.3",
    "vite": "^5.3.4",
    "@vitejs/plugin-vue": "^5.0.5",
    "concurrently": "^8.2.2",
    "wait-on": "^7.2.0",
    "cross-env": "^7.0.3"
  },
  "build": {
    "appId": "com.imageforge.app",
    "productName": "Loomora",
    "files": [
      "main.js",
      "preload.js",
      "renderer-dist/**/*"
    ],
    "win": {
      "target": "nsis"
    }
  }
}
