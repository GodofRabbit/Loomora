{
  "name": "Loomora",
  "version": "1.0.0",
  "description": "文生图工作台",
  "author": "伟大的兔神 <believe_rl@163.com>",
  "license": "SEE LICENSE IN LICENSE",
  "main": "main.js",
  "scripts": {
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "dev": "concurrently -k \"npm:dev:ui\" \"npm:dev:electron\"",
    "dev:ui": "vite --host 127.0.0.1 --port 5173 --strictPort",
    "dev:electron": "wait-on http://127.0.0.1:5173 && cross-env VITE_DEV_SERVER_URL=http://127.0.0.1:5173 node scripts/electron-dev-watch.js",
    "build:ui": "vite build",
    "test": "node --test test/providers.test.js",
    "start": "npm run dev",
    "start:prod": "npm run build:ui && electron .",
    "dist": "npm run build:ui && node scripts/package-app.js",
    "dist:win": "npm run build:ui && node scripts/package-app.js --win",
    "dist:mac": "npm run build:ui && node scripts/package-app.js --mac"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^5.0.5",
    "@paddlejs-models/ocr": "^1.2.4",
    "concurrently": "^8.2.2",
    "cross-env": "^7.0.3",
    "electron": "^31.0.0",
    "electron-builder": "^24.13.3",
    "lucide-vue-next": "^0.468.0",
    "prettier": "^3.9.6",
    "tui-image-editor": "^3.15.3",
    "vite": "^5.3.4",
    "vue": "^3.4.31",
    "wait-on": "^7.2.0"
  },
  "build": {
    "appId": "com.imageforge.app",
    "productName": "Loomora",
    "asar": true,
    "compression": "maximum",
    "npmRebuild": false,
    "removePackageScripts": true,
    "removePackageKeywords": true,
    "electronLanguages": [
      "en-US",
      "zh-CN",
      "zh-TW"
    ],
    "files": [
      "main.js",
      "preload.js",
      "electron/**/*",
      "renderer/assets/logo-system.png",
      "build/icon-system.ico",
      "renderer-dist/**/*",
      "!**/.env",
      "!**/.env.*",
      "!**/onboarding-state.json",
      "!**/Gallery{,/**}",
      "!**/tmp{,/**}",
      "!**/dist{,/**}"
    ],
    "win": {
      "icon": "build/icon-system.ico",
      "target": "nsis"
    },
    "nsis": {
      "differentialPackage": false,
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "include": "build/installer.nsh",
      "installerLanguages": [
        "zh_CN"
      ],
      "multiLanguageInstaller": true,
      "language": "2052",
      "installerHeader": "build/installer-header.bmp",
      "installerSidebar": "build/installer-sidebar.bmp",
      "uninstallerSidebar": "build/installer-sidebar.bmp"
    },
    "mac": {
      "icon": "build/icon-system.icns",
      "target": "dmg",
      "category": "public.app-category.graphics-design"
    }
  }
}
