{
  "name": "Loomora",
  "version": "1.0.0",
  "description": "文生图工作台",
  "main": "main.js",
  "scripts": {
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "dev": "concurrently -k \"npm:dev:ui\" \"npm:dev:electron\"",
    "dev:ui": "vite --host 127.0.0.1 --port 5173 --strictPort",
    "dev:electron": "wait-on http://127.0.0.1:5173 && cross-env VITE_DEV_SERVER_URL=http://127.0.0.1:5173 node scripts/electron-dev-watch.js",
    "build:ui": "vite build",
    "start": "npm run dev",
    "start:prod": "npm run build:ui && electron .",
    "dist": "electron-builder",
    "dist:win": "electron-builder --win nsis",
    "dist:mac": "electron-builder --mac dmg"
  },
  "dependencies": {
    "@paddlejs-models/ocr": "^1.2.4",
    "tui-image-editor": "^3.15.3",
    "vue": "^3.4.31"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^5.0.5",
    "concurrently": "^8.2.2",
    "cross-env": "^7.0.3",
    "electron": "^31.0.0",
    "electron-builder": "^24.13.3",
    "prettier": "^3.9.6",
    "vite": "^5.3.4",
    "wait-on": "^7.2.0"
  },
  "build": {
    "appId": "com.imageforge.app",
    "productName": "Loomora",
    "files": [
      "main.js",
      "preload.js",
      "electron/**/*",
      "renderer-dist/**/*"
    ],
    "win": {
      "target": "nsis"
    },
    "mac": {
      "target": "dmg",
      "category": "public.app-category.graphics-design"
    }
  }
}
